{
  "name": "homebridge-stream-sensors",
  "displayName": "Stream Sensors",
  "version": "1.1.4",
  "description": "Homebridge plugin that turns camera/video streams into HomeKit motion sensors using on-device object detection (animals, people, vehicles, packages)",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "dist/model/",
    "model/",
    "config.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "camera",
    "rtsp",
    "object-detection",
    "yolo",
    "onnx",
    "motion-sensor",
    "person-detection",
    "package-detection",
    "vehicle-detection",
    "animal-detection",
    "smart-home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikitakatchik/homebridge-stream-sensors.git"
  },
  "bugs": {
    "url": "https://github.com/nikitakatchik/homebridge-stream-sensors/issues"
  },
  "homepage": "https://github.com/nikitakatchik/homebridge-stream-sensors#readme",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.26.0"
  }
}
